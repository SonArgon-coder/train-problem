# ==============================================================================
# Indian Railways Intelligent Travel & Autonomous AI Governance Platform
# Configuration Environment Template
# ==============================================================================

# Core Infrastructure
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=railway_admin
POSTGRES_PASSWORD=railway_secure_pass
POSTGRES_DB=railway_ecosystem
DATABASE_URL=postgresql://railway_admin:railway_secure_pass@postgres:5432/railway_ecosystem

# Service Database Isolation (Supports independent databases per domain)
WL_DATABASE_URL=postgresql://railway_admin:railway_secure_pass@postgres:5432/railway_ecosystem
RECOMMENDER_DATABASE_URL=postgresql://railway_admin:railway_secure_pass@postgres:5432/railway_ecosystem
DELAY_DATABASE_URL=postgresql://railway_admin:railway_secure_pass@postgres:5432/railway_ecosystem
FARE_DATABASE_URL=postgresql://railway_admin:railway_secure_pass@postgres:5432/railway_ecosystem
GOVERNANCE_DATABASE_URL=postgresql://railway_admin:railway_secure_pass@postgres:5432/railway_ecosystem
AUDIT_DATABASE_URL=postgresql://railway_admin:railway_secure_pass@postgres:5432/railway_ecosystem

# LLM Execution Mode (Default: 'local' for zero-cost self-contained mode)
# Options: 'local' | 'openai' | 'groq' | 'ollama'
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Paths & Storage
DATASETS_DIR=/app/datasets
REGISTRY_DIR=/app/models_registry
AUDIT_STORAGE_DIR=/app/audit_storage

# Microservice Upstream Routing for Gateway
WL_SERVICE_URL=http://wl-predictor:8001
RECOMMENDER_SERVICE_URL=http://recommender:8002
DELAY_SERVICE_URL=http://delay-predictor:8003
FARE_SERVICE_URL=http://fare-predictor:8004
PLANNER_SERVICE_URL=http://planner-agent:8005
SUPPORT_SERVICE_URL=http://support-assistant:8006
FRAUD_SERVICE_URL=http://fraud-detector:8007
GOVERNANCE_SERVICE_URL=http://governance:8008

# Frontend Gateway Connection
INTERNAL_GATEWAY_URL=http://gateway:8000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
